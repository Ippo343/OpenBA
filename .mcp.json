{
  "mcpServers": {
    "ghidra-mcp": {
      "command": "tools/ghidra_mcp/.venv/Scripts/python.exe",
      "args": [
        "tools/ghidra_mcp/bridge_mcp_ghidra.py"
      ],
      "env": {
        "GHIDRA_SERVER_URL": "http://127.0.0.1:8089/"
      }
    },
    "vscode-debugger": {
      "type": "sse",
      "url": "http://127.0.0.1:10101/mcp-events"
    },
    "vscode": {
      "command": "cmd",
      "args": ["/c", "npx", "vscode-as-mcp-server"]
    },
    "renderdoc": {
      "command": "tools/renderdoc_mcp/.venv/Scripts/python.exe",
      "args": ["-m", "renderdoc_mcp"],
      "env": {
        "RENDERDOC_MODULE_PATH": "tools/renderdoc_mcp/runtime"
      }
    }
  }
}
