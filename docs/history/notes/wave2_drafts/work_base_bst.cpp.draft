// Reimpl of TradeDescription_impl_3480 (0x140013480): AVL retrace for ClearArea BST.
// Walks upward from *cur, rebalancing using ClearBST rotations.
// left=+0x18, right=+0x20, parent=+0x10, balance=+0x28, height=+0x2a.
static void ClearBST_Retrace(uintptr_t* root, uintptr_t* cur) {
    uintptr_t node = *cur;
    while (node != 0) {
        uintptr_t next = *reinterpret_cast<uintptr_t*>(node + 0x10);  // parent (+0x10)

        int16_t lh = 0, rh = 0;
        uintptr_t lc = *reinterpret_cast<uintptr_t*>(node + 0x18);
        uintptr_t rc = *reinterpret_cast<uintptr_t*>(node + 0x20);
        if (lc) lh = *reinterpret_cast<int16_t*>(lc + 0x2a) + 1;
        if (rc) rh = *reinterpret_cast<int16_t*>(rc + 0x2a) + 1;
        *reinterpret_cast<int16_t*>(node + 0x28) = (int16_t)(rh - lh);
        *reinterpret_cast<int16_t*>(node + 0x2a) = (rh > lh) ? rh : lh;

        // Right-heavy
        rc = *reinterpret_cast<uintptr_t*>(node + 0x20);
        if (*reinterpret_cast<int16_t*>(node + 0x28) > 1 && rc != 0) {
            if (*reinterpret_cast<int16_t*>(rc + 0x28) < 1 && *reinterpret_cast<int16_t*>(rc + 0x28) < 0) {
                ClearBST_RotateRight(root, rc);
                // After rotation, re-read node
            }
            node = *cur;
            ClearBST_RotateLeft(root, node);
        }
        // Left-heavy
        node = *cur;
        if (*reinterpret_cast<int16_t*>(node + 0x28) < -1) {
            lc = *reinterpret_cast<uintptr_t*>(node + 0x18);
            if (lc != 0) {
                if (*reinterpret_cast<int16_t*>(lc + 0x28) > -1 && *reinterpret_cast<int16_t*>(lc + 0x28) > 0) {
                    ClearBST_RotateLeft(root, lc);
                    // re-read
                }
                node = *cur;
                ClearBST_RotateRight(root, node);
            }
        }

        *cur = next;
        node = next;
    }
}

// Allocation helper: alloc a new 0x30-byte ClearArea BST node and copy key pair from keyData.
// Reimpl of ClearArea_helper_9920_sub_9b40 (0x140029b40): alloc new node, copy 16-byte key.
// param_2 = pointer to key struct (key[0] at +0, key[1] at +8), param_3 = parent ptr.
static void* ClearBST_AllocNode(void* keyData, uintptr_t parent) {
