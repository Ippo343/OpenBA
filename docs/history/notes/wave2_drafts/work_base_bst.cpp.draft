            }
            // Increment count
            *reinterpret_cast<int*>(reinterpret_cast<uintptr_t>(bstRoot) + 8) += 1;
next_cell_entry:;
        }
    } else {
        // SAVE: in-order traversal (leftmost node first via parent-pointer walk)
        uintptr_t cur = header[0];
        if (cur == 0) return;
        // Find leftmost
        while (*reinterpret_cast<uintptr_t*>(cur + 0x18) != 0)
            cur = *reinterpret_cast<uintptr_t*>(cur + 0x18);

        uintptr_t prev = cur;
