// ============================================================
// ClearArea cell-BST serialize (TradeDescription_impl_9de0 at 0x140029de0)
// This tree stores (key:int32, ibp:void*) pairs in 0x30-byte nodes.
// Node layout: +0x00=key(int32), +0x08=ibp(ptr), +0x10=parent, +0x18=left(ptr via +0x06*4),
//   actually using int-indexed pointers (piVar style):
//   node as int*: [0]=key, [2]=[4]=ibpPtr (8-byte at +8), [4]=parent (at +0x10),
//   [6]=left (at +0x18), [8]=right (at +0x20), [0xa]=height(int32)
// From Ghidra: all pointer children at int[6] (+0x18) and int[8] (+0x20).
// balance at int[4] pairs (+0x10? no) — need re-read.
// Re-examining decompile: `piVar[6]` = int*[6] = at byte offset 24 = 0x18 (left)
//   `piVar[8]` = at byte offset 32 = 0x20 (right), `piVar[4]` = at byte offset 16 = 0x10 (parent)
//   `*(int*)(piVar5 + 0x2a)` = height, `*(int*)(piVar5 + 0x28)` = balance
// So this IS the same ClearArea tree layout (2-word key at 0, parent at +0x10,
//   left at +0x18, right at +0x20, balance at +0x28, height at +0x2a)
// BUT node size may differ: Ghidra uses piVar (int*) so piVar[6] = byte 0x18, piVar[8]=0x20.
// Allocation: MemAlloc(0x30, 8). Same 0x30-byte node.
// Key differences from 9a40: key is int32 (not uint64 pair), and value is IBP (ptr).
// ============================================================

// Alloc helper for 9de0 tree (int key + IBP value, node size 0x30)
// Node: +0x00=key(int32), +0x04=pad(0), +0x08=ibpPtr(ptr), +0x10=parent, +0x18=left, +0x20=right
// Note: allocation of child node sets parent to piVar (the current node), left child of piVar.
// From decompile: piVar3 = MemAlloc(0x30, 8); piVar3[0]=local_28[0]; piVar3[2..3]=0;
//   *(int**)(piVar3+2)=local_20; *(int**)(piVar3+4)=piVar1; piVar3[6..10]=0
//   piVar3[2] = int[2] = byte offset 8 = ibpPtr; piVar3[4] = int[4] = byte offset 16 = parent
static void* CellBST_AllocNode(int key, void* ibp, uintptr_t parent) {
    void* raw = fn_MemAlloc ? fn_MemAlloc(g_pMemAllocSingleton, 0x30, 8) : nullptr;
    if (!raw) return nullptr;
    int* n = reinterpret_cast<int*>(raw);
    n[0]  = key;    // +0x00 key
    n[1]  = 0;      // +0x04 pad
    *reinterpret_cast<void**>(n + 2) = ibp;      // +0x08 ibpPtr
    *reinterpret_cast<uintptr_t*>(n + 4) = parent; // +0x10 parent
    n[6]  = 0; n[7]  = 0;  // +0x18 left
    n[8]  = 0; n[9]  = 0;  // +0x20 right
    n[10] = 0;              // +0x28 balance+height
    n[11] = 0;
    return raw;
}

// Reimpl of TradeDescription_impl_9de0 (0x140029de0): ClearArea cell-BST serialize.
// On load: reads count, then for each entry: reads int key + IBP, validates type,
//   allocates node, inserts into BST (no retrace in decompile on simple insert path).
//   After each group insert calls TradeDescription_impl_3480 for retrace.
// On save: walks tree in-order (leftmost first) and writes key+IBP for each node.
// Signature: void fn(void* bstRoot, void* serializer)
void WorkBST_BST_Serialize_Cell_9de0(void* bstRoot, void* serializer) {
    uintptr_t* header = reinterpret_cast<uintptr_t*>(bstRoot);
    int count = static_cast<int>(
        *reinterpret_cast<int32_t*>(reinterpret_cast<uintptr_t>(bstRoot) + 8));

    if (g_fn_Serialize_Int) g_fn_Serialize_Int(serializer, &count, nullptr);

    uintptr_t ser_vtbl = *reinterpret_cast<uintptr_t*>(serializer);
    bool isLoad = (*reinterpret_cast<int*>(ser_vtbl + 8) == 0);

