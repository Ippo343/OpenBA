                void* newNode = CellBST_AllocNode(key, ibp, 0);
                header[0] = reinterpret_cast<uintptr_t>(newNode);
            } else {
                int* node = reinterpret_cast<int*>(cur);
                int* insertParent = nullptr;
                bool inserted = false;
                while (true) {
                    int* local_res8 = node;
                    int* piVar1 = local_res8;
                    if (*local_res8 <= key) {
                        if (key <= *local_res8) {
                            // Duplicate: skip (decompile jumps to count-increment)
                            goto next_cell_entry;
                        }
                        // Go right (+0x20 = int[8])
                        int* rc = *reinterpret_cast<int**>(local_res8 + 8);
                        if (rc == nullptr) {
                            void* nn = CellBST_AllocNode(key, ibp, reinterpret_cast<uintptr_t>(piVar1));
                            *reinterpret_cast<void**>(piVar1 + 8) = nn;
                            insertParent = local_res8;
                            inserted = true;
                            break;
                        }
                        node = rc;
                    } else {
                        // Go left (+0x18 = int[6])
                        int* lc = *reinterpret_cast<int**>(local_res8 + 6);
                        if (lc == nullptr) {
                            void* nn = CellBST_AllocNode(key, ibp, reinterpret_cast<uintptr_t>(piVar1));
                            *reinterpret_cast<void**>(piVar1 + 6) = nn;
                            insertParent = local_res8;
                            inserted = true;
                            break;
