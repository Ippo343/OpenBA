        reinterpret_cast<uintptr_t>(keyData) + 8);                                    // key[1]
    *reinterpret_cast<uintptr_t*>(n + 0x10) = parent;  // parent
    *reinterpret_cast<uint64_t*>(n + 0x18) = 0;        // left
    *reinterpret_cast<uint64_t*>(n + 0x20) = 0;        // right
    *reinterpret_cast<uint32_t*>(n + 0x28) = 0;        // balance + height (padding)
