// code/Game/Work/work_base_bst.cpp
// BST/AVL and ClearArea tree helpers shared by many Work classes.
//
// These exe sub-helpers are resolved via ResolveAddr(Module::Exe, 0xADDR) from
// code/Game/Work/*.cpp files. In DLL mode they resolve to the original exe code;
// in standalone mode they resolve to 0 unless registered here.
//
// Wave 2 (Work) — BST/ClearArea-tree sub-batch.  Each function is a 1:1 port of
// the decompiled exe helper; do not "improve" behavior.
//
// This file must NOT depend on hooks.h — it is portable for the standalone exe.
//
// Node layouts (both trees use 0x30-byte nodes):
//   Simple BST (BSTFindRemove / BSTRemove / BST_Serialize):
//     +0x00  key    (uint64_t)
//     +0x08  parent (ptr)
//     +0x10  left   (ptr)
//     +0x18  right  (ptr)
//     +0x20  balance (int16_t, right - left)
//     +0x22  height  (int16_t, max child height + 1)
//     ... 8 bytes padding to 0x30
//
//   ClearArea tree (ClearArea_GroundInsert / TradeDescription_impl_ca60):
//     +0x00  key[0] (uint64_t, e.g. tileIdx)
//     +0x08  key[1] (uint64_t, e.g. citizenRef)
//     +0x10  parent (ptr)
//     +0x18  left   (ptr)
//     +0x20  right  (ptr)
//     +0x28  balance (int16_t, right - left)
//     +0x2a  height  (int16_t)
//     ... 4 bytes padding to 0x30
//
// BST root header: [0] = root ptr (void*), [+8] = count (int32_t)

#include "engine_funcs.h"
#include "resolve.h"
#include <cstdint>

// ============================================================
// Simple BST helpers (0x14001a6e0 / 0x140025520 / 0x1400296b0)
// key at +0x00, parent at +0x08, left at +0x10, right at +0x18,
// balance at +0x20 (int16), height at +0x22 (int16)
// ============================================================

// Helper: update balance/height on a simple-BST node given its children.
// Node layout: left at +0x10, right at +0x18, balance at +0x20, height at +0x22.
static inline void SimpleBST_UpdateNode(uintptr_t node) {
    int16_t lh = 0, rh = 0;
    uintptr_t lc = *reinterpret_cast<uintptr_t*>(node + 0x10);
    uintptr_t rc = *reinterpret_cast<uintptr_t*>(node + 0x18);
    if (lc) lh = *reinterpret_cast<int16_t*>(lc + 0x22) + 1;
    if (rc) rh = *reinterpret_cast<int16_t*>(rc + 0x22) + 1;
    *reinterpret_cast<int16_t*>(node + 0x20) = (int16_t)(rh - lh);
    *reinterpret_cast<int16_t*>(node + 0x22) = (rh > lh) ? rh : lh;
}

// Reimpl of FUN_140014c70: AVL rotate-left (simple BST, right child up).
// Ghidra name: FUN_140014c70.  Signature: longlong fn(longlong* root, longlong node)
// Both children use offsets +0x10 (left) and +0x18 (right).
static uintptr_t SimpleBST_RotateLeft(uintptr_t* root, uintptr_t node) {
    uintptr_t rc = *reinterpret_cast<uintptr_t*>(node + 0x18);  // right child becomes new root

    // Update tree root / parent's child pointer
    if (node == *root) {
        *root = rc;
    } else {
        uintptr_t par = *reinterpret_cast<uintptr_t*>(node + 0x08);
        if (par) {
            if (*reinterpret_cast<uintptr_t*>(par + 0x10) == node)
                *reinterpret_cast<uintptr_t*>(par + 0x10) = rc;
            else
                *reinterpret_cast<uintptr_t*>(par + 0x18) = rc;
        }
    }
    // rc's parent <- node's parent
    *reinterpret_cast<uintptr_t*>(rc + 0x08) = *reinterpret_cast<uintptr_t*>(node + 0x08);
    // node's right <- rc's left
    uintptr_t rcl = *reinterpret_cast<uintptr_t*>(rc + 0x10);
    *reinterpret_cast<uintptr_t*>(node + 0x18) = rcl;
    if (rcl) *reinterpret_cast<uintptr_t*>(rcl + 0x08) = node;
    // rc's left <- node
    *reinterpret_cast<uintptr_t*>(rc + 0x10) = node;
    *reinterpret_cast<uintptr_t*>(node + 0x08) = rc;
    // Recompute balance/height bottom-up
    SimpleBST_UpdateNode(node);
    // rc's right child
    uintptr_t rcr = *reinterpret_cast<uintptr_t*>(rc + 0x18);
    if (rcr) SimpleBST_UpdateNode(rcr);
    SimpleBST_UpdateNode(rc);
    return rc;
}

// Reimpl of FUN_140014da0: AVL rotate-right (simple BST, left child up).
static uintptr_t SimpleBST_RotateRight(uintptr_t* root, uintptr_t node) {
    uintptr_t lc = *reinterpret_cast<uintptr_t*>(node + 0x10);  // left child becomes new root

    if (node == *root) {
        *root = lc;
    } else {
        uintptr_t par = *reinterpret_cast<uintptr_t*>(node + 0x08);
        if (par) {
            if (*reinterpret_cast<uintptr_t*>(par + 0x10) == node)
                *reinterpret_cast<uintptr_t*>(par + 0x10) = lc;
            else
                *reinterpret_cast<uintptr_t*>(par + 0x18) = lc;
        }
    }
    *reinterpret_cast<uintptr_t*>(lc + 0x08) = *reinterpret_cast<uintptr_t*>(node + 0x08);
    uintptr_t lcr = *reinterpret_cast<uintptr_t*>(lc + 0x18);
    *reinterpret_cast<uintptr_t*>(node + 0x10) = lcr;
    if (lcr) *reinterpret_cast<uintptr_t*>(lcr + 0x08) = node;
    *reinterpret_cast<uintptr_t*>(lc + 0x18) = node;
    *reinterpret_cast<uintptr_t*>(node + 0x08) = lc;
    // Recompute bottom-up
    SimpleBST_UpdateNode(node);
    uintptr_t lcl = *reinterpret_cast<uintptr_t*>(lc + 0x10);
    if (lcl) SimpleBST_UpdateNode(lcl);
    SimpleBST_UpdateNode(lc);
    return lc;
}

// Reimpl of CitizenAI_State_Leisure_sub_a8c0 (0x14001a8c0): AVL retrace for simple BST.
// Walks from node (*param_2) upward, rebalancing as needed using the simple BST rotations.
// param1 = ptr to root ptr; param2 = ptr to "current" node ptr (traversal pointer).
// Uses left=+0x10, right=+0x18, parent=+0x08, balance=+0x20, height=+0x22.
static void SimpleBST_Retrace(uintptr_t* root, uintptr_t* cur) {
    uintptr_t node = *cur;
    while (node != 0) {
        uintptr_t next = *reinterpret_cast<uintptr_t*>(node + 0x08);  // parent

        int16_t lh = 0, rh = 0;
        uintptr_t lc = *reinterpret_cast<uintptr_t*>(node + 0x10);
        uintptr_t rc = *reinterpret_cast<uintptr_t*>(node + 0x18);
        if (lc) lh = *reinterpret_cast<int16_t*>(lc + 0x22) + 1;
        if (rc) rh = *reinterpret_cast<int16_t*>(rc + 0x22) + 1;
        *reinterpret_cast<int16_t*>(node + 0x20) = (int16_t)(rh - lh);
        *reinterpret_cast<int16_t*>(node + 0x22) = (rh > lh) ? rh : lh;

        // Right-heavy: balance > 1
        rc = *reinterpret_cast<uintptr_t*>(node + 0x18);
        if (*reinterpret_cast<int16_t*>(node + 0x20) > 1 && rc != 0) {
            if (*reinterpret_cast<int16_t*>(rc + 0x20) < 1 && *reinterpret_cast<int16_t*>(rc + 0x20) < 0) {
                SimpleBST_RotateRight(root, rc);
                node = *reinterpret_cast<uintptr_t*>(node + 0x18);  // node after right-rotate changed rc
                // re-read node pointer from decompile: `lVar6 = *param_2` after rotate
                node = *cur;  // original code re-reads from *param_2 which points to node
            }
            SimpleBST_RotateLeft(root, *cur);
        }
        // Left-heavy: balance < -1
        node = *cur;
        if (*reinterpret_cast<int16_t*>(node + 0x20) < -1) {
            lc = *reinterpret_cast<uintptr_t*>(node + 0x10);
            if (lc != 0) {
                if (*reinterpret_cast<int16_t*>(lc + 0x20) > -1 && *reinterpret_cast<int16_t*>(lc + 0x20) > 0) {
                    SimpleBST_RotateLeft(root, lc);
                    node = *cur;
                }
                SimpleBST_RotateRight(root, *cur);
            }
        }

        *cur = next;
        node = next;
    }
}

// Reimpl of CitizenAI_impl_a6e0 (0x14001a6e0): Remove a node from the simple BST.
// Full AVL delete with rebalance.
// Signature: void fn(void* bstRoot, void* node)
// bstRoot: pointer to BST header (root_ptr at +0x0, count at +0x8)
// node: pointer to the node to remove
void WorkBST_BSTRemove_a6e0(void* bstRoot, void* node) {
    uintptr_t* header = reinterpret_cast<uintptr_t*>(bstRoot);
    uintptr_t param_2 = reinterpret_cast<uintptr_t>(node);

    // Decrement count
    int* countPtr = reinterpret_cast<int*>(reinterpret_cast<uintptr_t>(bstRoot) + 8);
    (*countPtr)--;

    uintptr_t parent = *reinterpret_cast<uintptr_t*>(param_2 + 0x08);
    uintptr_t right  = *reinterpret_cast<uintptr_t*>(param_2 + 0x18);

    uintptr_t retraceFrom = parent;  // local_res8 in decompile

    if (right == 0) {
        // Node has no right child: splice out directly
        uintptr_t left = *reinterpret_cast<uintptr_t*>(param_2 + 0x10);
        if (parent == 0) {
            header[0] = left;
        } else if (*reinterpret_cast<void**>(parent + 0x10) == node) {
            *reinterpret_cast<uintptr_t*>(parent + 0x10) = left;
        } else {
            *reinterpret_cast<uintptr_t*>(parent + 0x18) = left;
        }
        right = left;  // lVar5 = left (per decompile)
    } else {
        // Has right child: find in-order predecessor (rightmost of left subtree)
        uintptr_t left = *reinterpret_cast<uintptr_t*>(param_2 + 0x10);
        uintptr_t pred = left;
        if (left != 0) {
            // Walk right to find in-order predecessor (rightmost of left subtree)
            while (*reinterpret_cast<uintptr_t*>(pred + 0x18) != 0) {
                pred = *reinterpret_cast<uintptr_t*>(pred + 0x18);
            }
            retraceFrom = 0;  // local_res8 = 0
            if (pred != left) {
                // pred is not immediate left child
                uintptr_t predLeft = *reinterpret_cast<uintptr_t*>(pred + 0x10);
                retraceFrom = *reinterpret_cast<uintptr_t*>(pred + 0x08);  // pred's parent
                *reinterpret_cast<uintptr_t*>(retraceFrom + 0x18) = predLeft;
                if (predLeft != 0) {
                    *reinterpret_cast<uintptr_t*>(predLeft + 0x08) = retraceFrom;
                }
                // Graft pred in place of removed node (left subtree)
                *reinterpret_cast<uintptr_t*>(pred + 0x10) = left;
                if (*reinterpret_cast<uintptr_t*>(retraceFrom + 0x10) == 0) {
                    int16_t sVar7 = 0, sVar6 = 0, sVar3;
                    uintptr_t rl = *reinterpret_cast<uintptr_t*>(retraceFrom + 0x10);
                    uintptr_t rr = *reinterpret_cast<uintptr_t*>(retraceFrom + 0x18);
                    if (rl) sVar7 = *reinterpret_cast<int16_t*>(rl + 0x22) + 1;
                    if (rr) sVar6 = *reinterpret_cast<int16_t*>(rr + 0x22) + 1;
                    sVar3 = (sVar6 > sVar7) ? sVar6 : sVar7;
                    *reinterpret_cast<int16_t*>(retraceFrom + 0x20) = (int16_t)(sVar6 - sVar7);
                    *reinterpret_cast<int16_t*>(retraceFrom + 0x22) = sVar3;
                }
            }
            right = retraceFrom;  // lVar5 = local_res8 per decompile flow
            // Link right subtree into pred
            *reinterpret_cast<uintptr_t*>(pred + 0x18) = *reinterpret_cast<uintptr_t*>(param_2 + 0x18);
            // Update pred's new children's parent pointers
            if (*reinterpret_cast<uintptr_t*>(pred + 0x10) != 0) {
                *reinterpret_cast<uintptr_t*>(*reinterpret_cast<uintptr_t*>(pred + 0x10) + 0x08) = pred;
            }
            if (*reinterpret_cast<uintptr_t*>(pred + 0x18) != 0) {
                *reinterpret_cast<uintptr_t*>(*reinterpret_cast<uintptr_t*>(pred + 0x18) + 0x08) = pred;
            }
            // Link pred to node's parent
            uintptr_t np = *reinterpret_cast<uintptr_t*>(param_2 + 0x08);
            *reinterpret_cast<uintptr_t*>(pred + 0x08) = np;
            if (np == 0) {
                header[0] = pred;
                *reinterpret_cast<uintptr_t*>(pred + 0x08) = 0;
                pred = header[0];  // re-read per decompile
            } else if (*reinterpret_cast<void**>(np + 0x10) == node) {
                *reinterpret_cast<uintptr_t*>(np + 0x10) = pred;
            } else {
                *reinterpret_cast<uintptr_t*>(np + 0x18) = pred;
            }
            // Free removed node
            if (fn_MemFreeStatic) fn_MemFreeStatic(node);
            // Retrace from the lower disturbed point or pred
            uintptr_t retracePtr = (right == 0) ? pred : right;
            SimpleBST_Retrace(&header[0], &retracePtr);
            return;
        }
        // left == 0: no left child; node's right child replaces it
        if (parent == 0) {
            header[0] = right;
            right = *reinterpret_cast<uintptr_t*>(param_2 + 0x18);
        } else if (*reinterpret_cast<void**>(parent + 0x10) == node) {
            *reinterpret_cast<uintptr_t*>(parent + 0x10) = right;
            right = *reinterpret_cast<uintptr_t*>(param_2 + 0x18);
        } else {
            *reinterpret_cast<uintptr_t*>(parent + 0x18) = right;
            right = *reinterpret_cast<uintptr_t*>(param_2 + 0x18);
        }
    }

    if (right != 0) {
        *reinterpret_cast<uintptr_t*>(right + 0x08) = *reinterpret_cast<uintptr_t*>(param_2 + 0x08);
    }
    uintptr_t retraceStart = right;
    if (fn_MemFreeStatic) fn_MemFreeStatic(node);
    uintptr_t retracePtr = (retraceStart == 0) ? retraceFrom : retraceStart;
    SimpleBST_Retrace(&header[0], &retracePtr);
}

// Reimpl of CitizenAI_impl_5520 (0x140025520): BST find-by-key then remove.
// Searches the BST for the node whose key == *(uint64_t*)param_2 (IBP key),
// then calls BSTRemove on it.
// Signature: void fn(void* bstRoot, void* keyIBP)
void WorkBST_BSTFindRemove_25520(void* bstRoot, void* keyIBP) {
    uintptr_t* header = reinterpret_cast<uintptr_t*>(bstRoot);
    uintptr_t cur = header[0];
    if (cur == 0) return;

    if (fn_InternalBasePtr_CheckPtr) fn_InternalBasePtr_CheckPtr(&cur);
    uint64_t key = *reinterpret_cast<uint64_t*>(keyIBP);

    while (cur != 0) {
        if (fn_InternalBasePtr_CheckPtr) fn_InternalBasePtr_CheckPtr(&cur);
        uint64_t nodeKey = *reinterpret_cast<uint64_t*>(cur);
        if (key < nodeKey) {
            cur = *reinterpret_cast<uintptr_t*>(cur + 0x10);  // left
        } else {
            if (fn_InternalBasePtr_CheckPtr) fn_InternalBasePtr_CheckPtr(keyIBP);
            uint64_t key2 = *reinterpret_cast<uint64_t*>(keyIBP);
            if (key2 <= nodeKey) {
                // Found: keys are equal
                WorkBST_BSTRemove_a6e0(bstRoot, reinterpret_cast<void*>(cur));
                return;
            }
            cur = *reinterpret_cast<uintptr_t*>(cur + 0x18);  // right
        }
    }
}

// Reimpl of CitizenAI_impl_96b0 (0x1400296b0): BST serialize (simple IBP-keyed tree).
// On load (stream.direction==0): reads count, then for each entry reads an IBP,
//   validates it against type 0x1401c7158, then inserts into the BST.
// On save (stream.direction!=0): walks tree in-order via parent links and serializes each IBP.
// Signature: void fn(void* bstRoot, void* serializer)
void WorkBST_BST_Serialize_296b0(void* bstRoot, void* serializer) {
    uintptr_t* header = reinterpret_cast<uintptr_t*>(bstRoot);
    // Local count read/write target (mirrors local_res8 on original's stack)
    int count = static_cast<int>(header[1]);  // header[1] low-32 = count

    // Read/write count via g_fn_Serialize_Int
    if (g_fn_Serialize_Int) g_fn_Serialize_Int(serializer, &count, nullptr);

    // Check stream direction: *(int*)(*(longlong*)serializer + 8) == 0 means LOAD
    uintptr_t ser_vtbl = *reinterpret_cast<uintptr_t*>(serializer);
    bool isLoad = (*reinterpret_cast<int*>(ser_vtbl + 8) == 0);

    // BST insert function (CitizenAI_impl_1a30 at 0x140021a30)
    static void (*s_bst_insert)(void* root, void* retout, void* keyIBP) = nullptr;
    if (!s_bst_insert) {
        s_bst_insert = reinterpret_cast<void (*)(void*, void*, void*)>(
            ResolveAddr(Module::Exe, 0x140021a30));
    }

    // Type-ID pointer for validation (DWORD_1401c7158 = CitizenAI component type)
    static const uint32_t* s_pTid = nullptr;
    if (!s_pTid) {
        s_pTid = reinterpret_cast<const uint32_t*>(ResolveAddr(Module::Exe, 0x1401c7158));
    }

    if (isLoad) {
        // LOAD: read count entries and insert each into the BST
        for (int i = 0; i < count; i++) {
            uintptr_t ibpKey = 0;
            // Serialize the IBP
            if (fn_InternalBasePtr_Serialize)
                fn_InternalBasePtr_Serialize(&ibpKey, serializer);
            // Validate type
            void* ptr = reinterpret_cast<void*>(ibpKey);
            if (ptr != nullptr && fn_IsDerivedFrom && s_pTid) {
                if (!fn_IsDerivedFrom(ptr, *s_pTid))
                    ibpKey = 0;
            }
            // Insert into BST
            uintptr_t retOut = 0;
            if (s_bst_insert) s_bst_insert(bstRoot, &retOut, &ibpKey);
        }
    } else {
        // SAVE: walk tree in-order and serialize each node's IBP.
        // Original walks: go all the way right first (to find rightmost), then
        // traverses from rightmost back upward to leftmost while writing.
        // The Ghidra-decompiled walk is a non-recursive in-order traversal using
        // parent pointers; we replicate the same logic faithfully.
        uintptr_t cur = header[0];
        if (cur == 0) return;

        // Walk to rightmost leaf
        uintptr_t prev = cur;
        while (cur != 0) {
            prev = cur;
            cur = *reinterpret_cast<uintptr_t*>(cur + 0x18);  // right
        }
        // prev is now the rightmost node; original decompile's 'pIVar3 = rightmost'
        // The loop in decompile starts at pIVar6 = 0 with pIVar3 = rightmost, then
        // navigates upward through parents. To avoid confusion, use standard in-order.
        // The original writes in an unusual traversal order (decompile does right-to-left);
        // replicate exactly: traverse right-to-left (reverse in-order) by going right-then-left.

        // Standard faithful port of the decompiler output:
        // The outer loop: while pIVar6=pIVar3 != 0, serialize pIVar6, then:
        //   if right child: go right then all the way left (find leftmost of right)
        //   else: go up via parent until we came from a right child
        uintptr_t node = prev;
        while (node != 0) {
            // Serialize this node's IBP (at node+0x00, an InternalBasePtr)
            void* ibpPtr = reinterpret_cast<void*>(node);
            if (fn_InternalBasePtr_Serialize)
                fn_InternalBasePtr_Serialize(ibpPtr, serializer);
            // Validate type after serialization
            void* stored = *reinterpret_cast<void**>(node);
            if (stored != nullptr && fn_IsDerivedFrom && s_pTid) {
                if (!fn_IsDerivedFrom(stored, *s_pTid))
                    *reinterpret_cast<void**>(node) = nullptr;
            }
            // Advance: go to right child's leftmost, or go up
            uintptr_t rc = *reinterpret_cast<uintptr_t*>(node + 0x18);
            if (rc != 0) {
                uintptr_t next = rc;
                while (*reinterpret_cast<uintptr_t*>(next + 0x10) != 0)
                    next = *reinterpret_cast<uintptr_t*>(next + 0x10);
                node = next;
            } else {
                // Go up until we came from a left child
                uintptr_t par = *reinterpret_cast<uintptr_t*>(node + 0x08);
                if (par != 0) {
                    // We need to track: if par's right == node, skip, go higher
                    // The decompile traversal: go to parent; if we came from RIGHT, keep going up
                    // until we come from a LEFT side or reach root
                    uintptr_t child = node;
                    while (par != 0 && *reinterpret_cast<uintptr_t*>(par + 0x18) == child) {
                        child = par;
                        par = *reinterpret_cast<uintptr_t*>(par + 0x08);
                    }
                    node = par;
                } else {
                    node = 0;
                }
            }
        }
    }
}

// ============================================================
// ClearArea BST helpers (0x140029a40 / 0x14001ca60 / 0x140029de0)
// key[0] at +0x00, key[1] at +0x08, parent at +0x10, left at +0x18, right at +0x20,
// balance at +0x28 (int16), height at +0x2a (int16)
// ============================================================

// Helper: update balance/height on a ClearArea BST node.
static inline void ClearBST_UpdateNode(uintptr_t node) {
    int16_t lh = 0, rh = 0;
    uintptr_t lc = *reinterpret_cast<uintptr_t*>(node + 0x18);
    uintptr_t rc = *reinterpret_cast<uintptr_t*>(node + 0x20);
    if (lc) lh = *reinterpret_cast<int16_t*>(lc + 0x2a) + 1;
    if (rc) rh = *reinterpret_cast<int16_t*>(rc + 0x2a) + 1;
    *reinterpret_cast<int16_t*>(node + 0x28) = (int16_t)(rh - lh);
    *reinterpret_cast<int16_t*>(node + 0x2a) = (rh > lh) ? rh : lh;
}

// Reimpl of TradeDescription_helper_sub_9ad0_sub_e450 (0x14000e450):
// AVL rotate-left for ClearArea BST (right child up).
// left=+0x18, right=+0x20, parent=+0x10, balance=+0x28, height=+0x2a.
static uintptr_t ClearBST_RotateLeft(uintptr_t* root, uintptr_t node) {
    uintptr_t rc = *reinterpret_cast<uintptr_t*>(node + 0x20);

    if (node == *root) {
        *root = rc;
    } else {
        uintptr_t par = *reinterpret_cast<uintptr_t*>(node + 0x10);
        if (par) {
            if (*reinterpret_cast<uintptr_t*>(par + 0x18) == node)
                *reinterpret_cast<uintptr_t*>(par + 0x18) = rc;
            else
                *reinterpret_cast<uintptr_t*>(par + 0x20) = rc;
        }
    }
    *reinterpret_cast<uintptr_t*>(rc + 0x10) = *reinterpret_cast<uintptr_t*>(node + 0x10);
    uintptr_t rcl = *reinterpret_cast<uintptr_t*>(rc + 0x18);
    *reinterpret_cast<uintptr_t*>(node + 0x20) = rcl;
    if (rcl) *reinterpret_cast<uintptr_t*>(rcl + 0x10) = node;
    *reinterpret_cast<uintptr_t*>(rc + 0x18) = node;
    *reinterpret_cast<uintptr_t*>(node + 0x10) = rc;
    // Recompute: rc's left (was node, now updated), rc's right
    ClearBST_UpdateNode(node);
    uintptr_t rcr = *reinterpret_cast<uintptr_t*>(rc + 0x20);
    if (rcr) ClearBST_UpdateNode(rcr);
    ClearBST_UpdateNode(rc);
    return rc;
}

// Reimpl of TradeDescription_helper_sub_9ad0_sub_e580 (0x14000e580):
// AVL rotate-right for ClearArea BST (left child up).
static uintptr_t ClearBST_RotateRight(uintptr_t* root, uintptr_t node) {
    uintptr_t lc = *reinterpret_cast<uintptr_t*>(node + 0x18);

    if (node == *root) {
        *root = lc;
    } else {
        uintptr_t par = *reinterpret_cast<uintptr_t*>(node + 0x10);
        if (par) {
            if (*reinterpret_cast<uintptr_t*>(par + 0x18) == node)
                *reinterpret_cast<uintptr_t*>(par + 0x18) = lc;
            else
                *reinterpret_cast<uintptr_t*>(par + 0x20) = lc;
        }
    }
    *reinterpret_cast<uintptr_t*>(lc + 0x10) = *reinterpret_cast<uintptr_t*>(node + 0x10);
    uintptr_t lcr = *reinterpret_cast<uintptr_t*>(lc + 0x20);
    *reinterpret_cast<uintptr_t*>(node + 0x18) = lcr;
