            void* ibpPtr = reinterpret_cast<void*>(node + 0x08);
            if (fn_InternalBasePtr_Serialize) fn_InternalBasePtr_Serialize(ibpPtr, serializer);
            // Validate after serialization
            void* stored = *reinterpret_cast<void**>(node + 0x08);
            if (stored && fn_IsDerivedFrom && s_pTid) {
                if (!fn_IsDerivedFrom(stored, *s_pTid)) {
                    *reinterpret_cast<void**>(node + 0x08) = nullptr;
                    *reinterpret_cast<int32_t*>(node + 0x0c) = 0;
