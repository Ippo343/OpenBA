*.lock
*.log

# Screenshots / capture artifacts (intentional doc images live under images/ — keep those)
*.png
!images/**
standalone/*.png

# Standalone run-capture diagnostics (transient crash/trace dumps, not source)
notes/wp_runs/*.txt
notes/wp_runs/*.err
Banished_RE.lock

# RenderDoc captures (large binary .rdc artifacts)
captures/
*psd

# stress/perf run outputs (keep baselines, not results)
perf/results/
standalone/build-perf/
standalone/build-og/

# libm bit-exactness probe binaries (source is checked in; rebuild with the
# command in the header of tools/libm_probe/sweep.cpp)
tools/libm_probe/*.exe
tools/libm_probe/full_sweep.txt
